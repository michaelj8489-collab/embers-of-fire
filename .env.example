# Optional local-development-only safety switch for manual show-live testing.
# Local non-production Start requests fail closed unless this is exactly true.
# Keep false/blank in production. The server refuses true when NODE_ENV=production.
# When exactly true locally, live-start push is sent only to the authenticated
# admin's own registered devices.
SHOW_LIVE_ADMIN_TEST_MODE=false

# Trusted absolute application origin used for server-generated Stripe redirect URLs.
# For local development, set APP_URL=http://localhost:3000 in your real env file.
APP_URL=
